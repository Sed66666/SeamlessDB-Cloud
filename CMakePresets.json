{
    "version": 3,
    "configurePresets": [
        {
            "name": "enable-trace",
            "hidden": false,
            "description": "Enable trace",
            "binaryDir": "/root/SeamlessDB-Cloud/build/enable-trace",
            "cacheVariables": {
                "ENABLE_TRACE": true,
                "ENABLE_TRACE_DETAIL": true,
                "ENABLE_METRIC": true,
                "PRINT_LOG": false,
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "release",
            "hidden": false,
            "description": "release",
            "binaryDir": "/root/SeamlessDB-Cloud/build/release",
            "cacheVariables": {
                "ENABLE_TRACE": false,
                "ENABLE_METRIC": false,
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug",
            "hidden": false,
            "description": "debug",
            "binaryDir": "/root/SeamlessDB-Cloud/build/debug",
            "cacheVariables": {
                "ENABLE_TRACE": true,
                "ENABLE_TRACE_DETAIL": true,
                "ENABLE_METRIC": true,
                "PRINT_LOG": false,
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}